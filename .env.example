# FMCG Streaming Analytics - Environment Configuration
# Copy this file to .env and adjust values as needed

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SALES_TOPIC=fmcg-sales
KAFKA_PRICE_TOPIC=fmcg-price
KAFKA_CALENDAR_TOPIC=fmcg-calendar

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fmcg_analytics

# Producer Configuration
PRODUCER_SEND_INTERVAL=0.3
PRODUCER_MESSAGE_LIMIT=0

# Consumer Configuration
CONSUMER_GROUP_ID=fmcg-analytics-group
ANOMALY_THRESHOLD=2.0
ROLLING_WINDOW_SIZE=20

# Dashboard Configuration
DASHBOARD_PORT=8501
